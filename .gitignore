# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle related
.gradle/
**/android/.gradle/
**/build/
**/captures/
**/gradlew
**/gradlew.bat
**/local.properties
**/.cxx/

# Coverage related
/coverage/

# Fastlane related (if you use it)
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# FVM related (if you use Flutter Version Management)
.fvm/

# Generated files for web
lib/generated_plugin_registrant.dart

# Key files that should not be in version control
**/android/key.properties
**/*.keystore
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/ios/build/
**/ios/Pods/

# Native build files
**/*.so
**/*.dylib
**/*.dll
**/*.a

# 临时文件
**/temp/
**/.temp/
**/tmp/
**/.tmp/
